<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>alias</name>
        <type>character varying(50)</type>
        <null>NO</null>
    </column>
    <column>
        <name>aliastype</name>
        <type>character varying(30)</type>
        <null>NO</null>
    </column>
    <column>
        <name>cod</name>
        <type>character varying(50)</type>
        <null>NO</null>
    </column>
    <column>
        <name>favorite</name>
        <type>boolean</type>
        <null>NO</null>
        <default>false</default>
    </column>
    <column>
        <name>creationdate</name>
        <type>timestamp</type>
        <null>NO</null>
    </column>
    <column>
        <name>nick</name>
        <type>character varying(50)</type>
    </column>
    <column>
        <name>lastupdate</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>lastnick</name>
        <type>character varying(50)</type>
    </column>
    <constraint>
        <name>alias_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>alias_aliastype_alias_uniq</name>
        <type>UNIQUE (aliastype, alias)</type>
    </constraint>
    <constraint>
        <name>ca_alias_aliastypes</name>
        <type>FOREIGN KEY (aliastype) REFERENCES aliastypes (aliastype) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_alias_users_nick</name>
        <type>FOREIGN KEY (nick) REFERENCES users (nick) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_alias_users_lastnick</name>
        <type>FOREIGN KEY (lastnick) REFERENCES users (nick) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
</table>
